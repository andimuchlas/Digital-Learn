# ========================================================
# DIGITAL LEARN - ENVIRONMENT VARIABLES CONFIGURATION
# ========================================================

# 1. Supabase PostgreSQL Connection URL (Transaction / Session Pooler)
# Contoh: postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# 2. Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator
ADMIN_SESSION_SECRET=digital-learn-quiz-admin-session-secret-key-2026

# 4. Real-time WebSocket (Socket.io Backend URL)
NEXT_PUBLIC_SOCKET_URL=https://digital-learn.onrender.com
